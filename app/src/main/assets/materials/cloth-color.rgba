בבבמךךךססססףףףףףףףףףץץץפןןןעייינהההן׳׳׳כװװװך׀׀׀יֿֿֿטׁׁׁיױױױך״״״כאאאםךךךנףףףףףףףףרררץףףףףןןןעייינהההןÛÛÛלױױױךׁׁׁיּּּח׀׀׀טװװװךÚÚÚלגגגמחחחנמממעפפפפפפפפףףףףםםםסכככסגגגמÚÚÚכׂׂׂי׀׀׀יֽֽֽטֽֽֽט׃׃׃ך׳׳׳כאאאםכככסמממעפפפפקקקפץץץפנננעייינדדדמ״״״כׂׂׂיׁׁׁיֿֿֿטֽֽֽט׃׃׃יÚÚÚלßßßםייינןןןעףףףףרררץףףףףנננעטטטנßßßםÚÚÚכײײײךֿֿֿט׀׀׀יֿֿֿטײײײךÙÙÙכדדדמחחחןנננעסססףרררץףףףףןןןעטטטנדדדמÙÙÙכױױױךׁׁׁי׀׀׀י־־־ט׃׃׃ךÚÚÚלגגגמטטטנסססעףףףףצצצפצצצפסססףכככסאאאםÙÙÙכ׀׀׀יּּּחּּּחּּּח׃׃׃יÚÚÚלהההןךךךנעעעףקקקפרררץעעעףןןןעלללסßßßםÙÙÙכװװװךׁׁׁי־־־טֿֿֿטװװװךÜÜÜלדדדמייינןןןעץץץפרררץףףףףןןןעטטטנדדדמ״״״כװװװךׁׁׁי׀׀׀יֿֿֿטװװװךÚÚÚכאאאמלללסעעעףץץץפצצצפףףףףףףףףטטטנדדדמÜÜÜל׃׃׃ך׀׀׀יֻֻֻחֿֿֿטׁׁׁיÛÛÛלדדדמייינסססףץץץפקקקץפפפפמממעלללסדדדמÚÚÚלׂׂׂיֽֽֽחֻֻֻח׀׀׀יױױױך״״״כאאאםחחחנמממעףףףףףףףףץץץפמממעייינאאאמÛÛÛלײײײךּּּח־־־ט־־־טׂׂׂי׳׳׳כאאאםחחחננננעקקקפץץץפפפפףעעעףטטטנדדדמÚÚÚכׂׂׂיֽֽֽטֻֻֻחֽֽֽטׁׁׁי״״״כאאאמךךךנףףףףףףףףףףףףפפפפעעעףכככסהההןÚÚÚכׂׂׂיּּּחֻֻֻחׁׁׁיױױױך״״״כאאאםייינןןןעקקקפצצצפצצצפנננעלללסßßßם׳׳׳כׂׂׂיֿֿֿטּּּחׁׁׁיׂׂׂיÜÜÜלבבבמייינעעעףפפפפפפפפצצצפעעעףייינאאאםÙÙÙכױױױךׂׂׂיּּּחֽֽֽח׃׃׃ךÜÜÜלגגגמייינסססףףףףףףףףףפפפפמממעכככסאאאםÜÜÜלױױױךׁׁׁי׀׀׀י׀׀׀טױױױךÛÛÛלגגגמטטטנמממעףףףףרררץצצצפןןןעךךךנאאאםÛÛÛלװװװך׀׀׀יּּּח־־־טׁׁׁי׳׳׳כßßßםחחחנםםםעצצצפץץץפצצצפעעעףךךךסßßßםÜÜÜלװװװך׀׀׀י־־־טֽֽֽחׁׁׁי״״״כדדדמךךךסמממעצצצפקקקפעעעףןןןעךךךנßßßםÛÛÛלװװװךׁׁׁיּּּח׀׀׀יױױױך״״״כהההןחחחנעעעףףףףףץץץפצצצפסססףכככסהההן״״״כׂׂׂיֿֿֿטֽֽֽטֽֽֽטװװװך״״״כאאאםייינףףףףץץץפץץץפפפפפסססףייינהההןÚÚÚל׀׀׀י׀׀׀טֻֻֻחֽֽֽט׃׃׃ךÜÜÜלבבבמייינמממעצצצפפפפפעעעףעעעףךךךסאאאםÛÛÛלװװװך־־־ט׀׀׀יּּּחױױױךÜÜÜלבבבמחחחננננעצצצפפפפףעעעףעעעףייינדדדמÛÛÛלׂׂׂיׁׁׁיֿֿֿטֽֽֽטׂׂׂיÜÜÜלדדדמטטטנסססעצצצפרררץץץץפעעעףךךךנגגגמ״״״כװװװךׁׁׁיּּּחֽֽֽטׂׂׂיÙÙÙכאאאםחחחנןןןעפפפףצצצפףףףףןןןעטטטנהההן״״״כׂׂׂי־־־טֽֽֽטֽֽֽטׁׁׁיÜÜÜלגגגמכככססססףצצצפץץץפץץץפנננעךךךסהההןÚÚÚלׂׂׂיׁׁׁיֿֿֿטֽֽֽט׃׃׃ךÜÜÜלßßßםךךךנמממעץץץפשששץצצצפסססףלללסבבבמÙÙÙכ׀׀׀יֽֽֽט־־־ט׀׀׀יװװװךÙÙÙכגגגמלללסמממעקקקפצצצפפפפפנננעכככסגגגמ״״״כׂׂׂיּּּחֽֽֽטֿֿֿטװװװךÙÙÙכאאאםייינסססףפפפפצצצפץץץפןןןעךךךנאאאמÙÙÙכױױױךֽֽֽטֻֻֻחּּּח׃׃׃ךÜÜÜלאאאםטטטנףףףףףףףףשששץצצצפןןןעטטטנדדדמ׳׳׳כ׀׀׀יֽֽֽט־־־טּּּח׃׃׃י״״״כבבבמכככסנננעץץץפקקקפקקקפמממעכככסגגגמÛÛÛל׀׀׀ט־־־ט־־־טּּּחׂׂׂי״״״כגגגמךךךנסססעצצצפתתתץצצצפעעעףךךךנהההן״״״כ׃׃׃יֿֿֿט־־־ט־־־ט׀׀׀י״״״כהההןכככסףףףףרררץץץץפץץץפעעעףטטטנדדדמÚÚÚלׁׁׁיֿֿֿטÊÊÊחּּּחױױױך״״״כגגגמךךךנףףףףץץץפרררץצצצפפפפףךךךסהההן״״״כ׀׀׀יּּּחÊÊÊחּּּח׃׃׃ך״״״כאאאםייינףףףףףףףףצצצפצצצפסססעםםםסדדדמÛÛÛלׂׂׂיֻֻֻחֹֹֹח־־־טױױױך׳׳׳כבבבמטטטנעעעףרררץצצצפרררץנננעךךךנהההןÚÚÚכװװװך׀׀׀טֽֽֽטֿֿֿט׀׀׀י״״״כדדדמטטטננננעפפפףתתתץףףףףנננעכככסאאאמ״״״כױױױךֽֽֽטֻֻֻח׀׀׀יׂׂׂי״״״כßßßםלללסןןןעץץץפצצצפפפפפסססףחחחנגגגמÜÜÜלֿֿֿטֻֻֻחּּּחֽֽֽט׃׃׃יÙÙÙכדדדמטטטנעעעףרררץצצצפפפפףעעעףכככסאאאםÚÚÚלׂׂׂי־־־טּּּחּּּחװװװך׳׳׳כאאאםכככססססףקקקפץץץפצצצפףףףףכככסבבבמ״״״כׂׂׂיֻֻֻחֹֹֹחֽֽֽט׃׃׃י׳׳׳כבבבמכככסףףףףקקקפרררץקקקץןןןעךךךנבבבמ״״״כׂׂׂיּּּח־־־ט׀׀׀יװװװךÛÛÛלבבבמךךךנןןןעפפפףץץץפצצצפנננעטטטנדדדמ״״״כׂׂׂי־־־ט־־־טּּּחװװװךÚÚÚלאאאמלללסנננעקקקפץץץפרררץףףףףייינאאאמÚÚÚכֿֿֿט־־־טֻֻֻחּּּח׀׀׀יÛÛÛלßßßםייינסססףרררץקקקפפפפפסססףלללסהההןÚÚÚל׀׀׀יֽֽֽטּּּחּּּחװװװך״״״כגגגמךךךנמממעץץץפפפפפצצצפפפפףחחחנבבבמÛÛÛלׂׂׂיּּּחֹֹֹזּּּחׁׁׁיÙÙÙכגגגמחחחנןןןעפפפפקקקפצצצפןןןעייינדדדמ׳׳׳כֿֿֿטֻֻֻחּּּחֻֻֻחױױױךÙÙÙכהההןחחחנעעעףפפפפרררץפפפפמממעכככסגגגמÜÜÜלֿֿֿטֽֽֽטּּּח־־־טװװװך׳׳׳כדדדמכככסןןןעצצצפקקקפףףףףףףףףכככסאאאם׳׳׳כ׀׀׀יֻֻֻחּּּחֿֿֿטׂׂׂיÚÚÚלדדדמכככסעעעףץץץפרררץףףףףנננעלללסßßßם״״״כ׀׀׀יֽֽֽטֿֿֿטֻֻֻח׀׀׀יײײײךדדדמייינףףףףפפפפשששץץץץפסססףטטטנהההןÙÙÙכװװװךֻֻֻחֹֹֹזֿֿֿטׁׁׁיÙÙÙכדדדמייינסססףץץץפרררץקקקפנננעךךךנßßßםÛÛÛל׃׃׃יּּּחֽֽֽט׀׀׀יװװװךÙÙÙכגגגמלללסןןןעץץץפשששץרררץןןןעךךךנדדדמ׳׳׳כ׃׃׃יֽֽֽטֹֹֹזֿֿֿטױױױך״״״כאאאםלללסנננעקקקפתתתץצצצפףףףףכככסßßßםÛÛÛלׁׁׁיּּּחÊÊÊח׀׀׀טװװװךÛÛÛלßßßםיייננננעצצצפתתתץקקקפןןןעךךךנגגגמÚÚÚל׀׀׀טֽֽֽטֽֽֽטֽֽֽטׁׁׁיÙÙÙכבבבמךךךנףףףףץץץפקקקפפפפפמממעטטטנבבבמ״״״כױױױךּּּחÊÊÊח־־־ט׀׀׀יÙÙÙכבבבמחחחנעעעףץץץפקקקפפפפפנננעךךךסßßßם׳׳׳כװװװךֽֽֽחֽֽֽטֿֿֿטׂׂׂיÚÚÚלגגגמחחחנןןןעףףףףקקקפץץץפסססףלללסßßßםÛÛÛל׃׃׃ך׀׀׀טÊÊÊחֿֿֿטֿֿֿט״״״כßßßםחחחננננעקקקפצצצפקקקפנננעחחחנדדדמ׳׳׳כװװװךּּּחּּּחֽֽֽטׁׁׁיÚÚÚכגגגמטטטננננעץץץפקקקפעעעףנננעטטטנהההן׳׳׳כ׃׃׃י׀׀׀יֽֽֽטֽֽֽטװװװך״״״כדדדמךךךסןןןעעעעףפפפףקקקפסססףייינבבבמÚÚÚל׃׃׃ךׁׁׁיֻֻֻחֿֿֿט׃׃׃יÙÙÙכבבבמכככסמממעץץץפץץץפףףףףםםםסלללסבבבמ״״״כײײײך־־־טּּּחׂׂׂיׁׁׁי׳׳׳כßßßםייינסססףףףףףקקקפףףףףםםםעךךךסאאאםÜÜÜלױױױךֿֿֿט׀׀׀טׂׂׂיׂׂׂיÙÙÙכבבבמטטטנמממעעעעףרררץפפפפעעעףייינßßßםÚÚÚל׃׃׃יׁׁׁי־־־טּּּחײײײךÚÚÚלßßßםךךךנןןןעצצצפפפפףץץץפמממעחחחנגגגמ״״״כװװװך־־־טֻֻֻחּּּחױױױךÚÚÚלגגגמייינןןןעצצצפצצצפפפפףןןןעכככסאאאםÙÙÙכ׃׃׃י׀׀׀יֿֿֿטֽֽֽטׁׁׁיÚÚÚכßßßםייינסססףעעעףרררץףףףףנננעכככסדדדמÜÜÜלׁׁׁיֿֿֿט־־־טֽֽֽטׂׂׂיÛÛÛלßßßםייינמממעץץץפקקקפצצצפםםםסלללסהההןÚÚÚלװװװךׁׁׁיֽֽֽטֿֿֿט׃׃׃ך״״״כבבבמכככסנננעעעעףצצצפסססףמממעחחחנהההןÝÝÝלׂׂׂי׀׀׀י־־־טֽֽֽטװװװךÙÙÙכבבבמחחחןןןןעקקקפפפפפפפפףמממעכככסבבבמÚÚÚכ׃׃׃י־־־טֽֽֽטֿֿֿטׁׁׁיÜÜÜלאאאמטטטננננעפפפףקקקפףףףףןןןעייינגגגמÜÜÜל׃׃׃י׀׀׀י־־־ט׀׀׀יױױױך״״״כאאאםךךךסנננעעעעףצצצפףףףףןןןעטטטנאאאמÙÙÙכ׃׃׃ך׀׀׀יֽֽֽט־־־טװװװךÛÛÛלגגגמטטטנסססףפפפפץץץפצצצפמממעלללסגגגמ״״״כׂׂׂי־־־טּּּחׁׁׁיׁׁׁי״״״כדדדמכככסןןןעעעעףרררץקקקפןןןעכככסבבבמÜÜÜלׂׂׂיֿֿֿט׀׀׀יׁׁׁיױױױךÛÛÛלבבבמלללססססףץץץפפפפףעעעףמממעזזזןßßßםÙÙÙכ׃׃׃יֿֿֿט־־־ט־־־טױױױךÙÙÙכהההןךךךנעעעףצצצפץץץפפפפפסססעייינßßßםÙÙÙכװװװך־־־ט־־־טׁׁׁיװװװךÚÚÚכגגגמייינעעעףףףףףקקקץסססףנננעךךךסאאאםÛÛÛלײײײךׁׁׁיֻֻֻח׀׀׀יׁׁׁיÜÜÜלדדדמייינמממעצצצפצצצפץץץפןןןעלללסגגגמ׳׳׳כװװװךׁׁׁיּּּחֽֽֽט׃׃׃יÚÚÚלבבבמךךךססססףקקקפצצצפצצצפןןןעכככסאאאמÙÙÙכױױױךֽֽֽט׀׀׀יׁׁׁי׃׃׃י׳׳׳כהההןחחחננננעץץץפרררץפפפפסססףךךךנאאאמÙÙÙכװװװך׀׀׀ט־־־טֽֽֽטװװװךÜÜÜלהההןטטטננננעעעעףףףףףעעעףסססףכככסגגגמÚÚÚלׁׁׁיֿֿֿטֻֻֻחׁׁׁיׂׂׂיÝÝÝלאאאםטטטנםםםעקקקפףףףףףףףףנננעייינßßßםÛÛÛלײײײךֽֽֽטֽֽֽט־־־טװװװךÜÜÜלדדדמטטטנסססעצצצפרררץפפפפסססףכככסßßßםÛÛÛלװװװךׁׁׁיֿֿֿטׁׁׁיױױױךÜÜÜלגגגמייינףףףףסססףצצצפץץץפסססףזזזןהההןÚÚÚלׁׁׁיׂׂׂיּּּח־־־טױױױךÙÙÙכגגגמטטטנןןןעףףףףץץץפפפפפםםםסייינßßßם״״״כׂׂׂיׁׁׁי־־־טׁׁׁי׃׃׃יÚÚÚלגגגמחחחנסססףעעעףקקקפףףףףסססףלללסבבבמÚÚÚלׂׂׂיֿֿֿט־־־טׂׂׂי׃׃׃יÙÙÙכבבבמכככסןןןעףףףףצצצפץץץפןןןעייינאאאםÚÚÚל׃׃׃י־־־טּּּח־־־טײײײך״״״כבבבמחחחןףףףףצצצפץץץפץץץפמממעךךךסßßßם״״״כ׃׃׃יּּּחּּּחֿֿֿטײײײךÚÚÚלגגגמחחחננננעפפפףקקקפסססףמממעךךךנגגגמÝÝÝל׀׀׀יׂׂׂיֽֽֽטֿֿֿטׁׁׁיÛÛÛלדדדמךךךנםםםססססףקקקפקקקפןןןעכככסהההןÚÚÚלױױױך־־־טֿֿֿטֽֽֽחׂׂׂי״״״כגגגמלללסעעעףץץץפץץץפפפפפעעעףכככסדדדמÜÜÜלױױױך־־־ט־־־טּּּח׃׃׃יÚÚÚלßßßםטטטנךךךסנננעןןןעףףףףלללסייינאאאםÛÛÛל׳׳׳כׂׂׂיׂׂׂיׁׁׁיױױױךÙÙÙכגגגמזזזןןןןעסססףסססףנננעןןןעוווןßßßםÜÜÜלװװװךױױױך׀׀׀טׂׂׂי״״״כÛÛÛלßßßםזזזןךךךסןןןעמממעםםםסלללסחחחנבבבמÚÚÚכײײײך׃׃׃י׀׀׀יױױױךײײײכÛÛÛלדדדמטטטנםםםסםםםסנננעםםםעלללסחחחנהההןÙÙÙכÙÙÙכ׃׃׃ך׀׀׀יױױױךÙÙÙכÚÚÚלבבבמייינכככסנננעעעעףםםםסלללסזזזןגגגמÛÛÛל״״״כׂׂׂיׁׁׁיׁׁׁי׳׳׳כÝÝÝלדדדמזזזןןןןעסססףעעעףסססףןןןעזזזןבבבמÚÚÚלױױױך׃׃׃ךױױױך׃׃׃י׳׳׳כÚÚÚלגגגמוווןכככסנננעעעעףסססףךךךנייינגגגמÛÛÛל״״״כװװװךֿֿֿטײײײךÙÙÙכÛÛÛלדדדמייינםםםססססףעעעףסססףמממעחחחנדדדמÚÚÚכױױױךׁׁׁיׁׁׁיײײײךÙÙÙכÜÜÜלßßßםייינךךךנסססעעעעףםםםסךךךסטטטנהההןÜÜÜל׳׳׳כװװװך׀׀׀טײײײך״״״כÛÛÛלהההןייינםםםסןןןעמממענננעםםםסייינדדדמÜÜÜל״״״כ׃׃׃ךױױױךׁׁׁיÙÙÙכÝÝÝםבבבמטטטנךךךננננענננעמממעמממעייינגגגמÙÙÙכײײײךׁׁׁיׂׂׂיׁׁׁיױױױךÞÞÞםßßßםוווןמממעןןןעעעעףמממעלללסוווןאאאםÚÚÚלײײײךױױױךװװװךׂׂׂי״״״כÛÛÛלדדדמוווןךךךנמממעסססףעעעףםםםסטטטנגגגמÜÜÜל׳׳׳כׂׂׂיױױױךׁׁׁי״״״כÝÝÝלגגגמוווןלללסנננעסססענננעכככסייינßßßםÞÞÞםײײײךׂׂׂיׂׂׂי׃׃׃י״״״כÜÜÜלבבבמטטטנלללסןןןעסססףמממעלללסךךךנßßßםÚÚÚלÙÙÙכ׃׃׃י׃׃׃י׃׃׃יײײײךÛÛÛלאאאםזזזןלללסמממעפפפףמממעמממעייינבבבמÙÙÙכÙÙÙכײײײך׀׀׀טײײײך׳׳׳כÛÛÛלהההןטטטנךךךנמממעמממעסססעמממעךךךנגגגמÚÚÚלױױױךׂׂׂיׁׁׁי׃׃׃ך׳׳׳כÚÚÚלאאאמחחחןמממעמממעמממעסססףןןןעטטטנגגגמÚÚÚלÙÙÙכׂׂׂי׃׃׃ךׁׁׁי׳׳׳כÙÙÙכדדדמייינםםםססססףסססףןןןעכככסוווןדדדמÙÙÙכײײײך׃׃׃יװװװךװװװך״״״כÚÚÚכßßßםזזזןךךךנףףףףףףףףןןןעלללסטטטנאאאמÜÜÜלÙÙÙכׁׁׁיׁׁׁיׁׁׁיװװװךÞÞÞםדדדמטטטנםםםסםםםענננעעעעףלללסחחחןßßßםÚÚÚלװװװךׂׂׂיװװװך׃׃׃ךװװװךÜÜÜלהההןחחחנמממעמממענננעעעעףכככסוווןגגגמÚÚÚכװװװךױױױך׀׀׀יװװװךײײײךÛÛÛלßßßםחחחנןןןעסססףעעעףעעעףןןןעוווןßßßםÛÛÛלÙÙÙכׂׂׂיװװװךױױױךױױױךÝÝÝלדדדמוווןןןןענננעןןןעמממעמממעטטטנדדדמÞÞÞםױױױךׂׂׂיװװװךױױױךÙÙÙכÙÙÙכאאאםוווןםםםסףףףףעעעףןןןעמממעוווןבבבמÜÜÜלױױױךױױױך׀׀׀י׃׃׃יױױױךÚÚÚכßßßםחחחנמממעסססףמממעםםםסלללסוווןßßßםÚÚÚלÙÙÙכׁׁׁי׀׀׀יױױױך׳׳׳כÜÜÜלגגגמוווןכככסעעעףפפפףנננעךךךסוווןגגגמÜÜÜלװװװךױױױך׃׃׃י׃׃׃י׳׳׳כÚÚÚכדדדמזזזןןןןעףףףףנננעמממעןןןעזזזןßßßםÝÝÝםײײײך׃׃׃יׁׁׁיױױױךװװװךÞÞÞםגגגמךךךנכככססססףנננעמממעמממעזזזןאאאמÞÞÞם׳׳׳כײײײך׃׃׃ךׂׂׂיײײײךÛÛÛלבבבמזזזןכככסעעעףןןןענננעםםםסוווןגגגמÜÜÜלÙÙÙכװװװךױױױךׂׂׂי׳׳׳כÚÚÚלגגגמוווןןןןעמממעעעעףעעעףךךךסייינבבבמÞÞÞם׳׳׳כױױױך׀׀׀טװװװך״״״כÝÝÝלבבבמחחחנלללססססעףףףףןןןעלללסזזזןבבבמÝÝÝםװװװךװװװך׀׀׀טׁׁׁיײײײךÙÙÙכהההןהההןייינךךךנלללסייינייינזזזןבבבמÝÝÝםÞÞÞם״״״כÙÙÙכÚÚÚכÜÜÜלßßßםגגגמחחחנייינייינלללסךךךסזזזןדדדמבבבמßßßםÙÙÙכÜÜÜל״״״כÙÙÙכÞÞÞםßßßם